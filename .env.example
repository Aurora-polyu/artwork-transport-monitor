# Provide these variables through the process environment. The legacy project
# does not load .env files itself.
#
# New reconstruction configuration. Set a long random value in environments
# that run a future Flask application; never commit a real value here.
ARTWORK_MONITOR_PROFILE=demo
ARTWORK_MONITOR_FLASK_SECRET=replace-with-a-long-random-value
ARTWORK_MONITOR_HOST=127.0.0.1
ARTWORK_MONITOR_PORT=8000
ARTWORK_MONITOR_RUNTIME_DIR=instance
ARTWORK_MONITOR_DATABASE_PATH=artwork_monitor.sqlite3
ARTWORK_MONITOR_LOG_DIR=transport_logs
ARTWORK_MONITOR_EMAIL_HOST=
ARTWORK_MONITOR_EMAIL_PORT=
ARTWORK_MONITOR_EMAIL_SENDER=
ARTWORK_MONITOR_EMAIL_PASSWORD=
ARTWORK_MONITOR_EMAIL_RECIPIENT=

# Legacy configuration, retained only for its untouched reference application.
SOTHEBY_FLASK_SECRET_KEY=replace-with-a-long-random-value
ARTWORK_SMTP_SERVER=smtp.gmail.com
ARTWORK_SMTP_PORT=587
ARTWORK_EMAIL_SENDER=sender@example.invalid
ARTWORK_EMAIL_PASSWORD=replace-with-app-password
ARTWORK_EMAIL_RECIPIENT=recipient@example.invalid
